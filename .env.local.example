# Copy this file to .env.local and fill in the values from
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: turns on AI rewrites (Condense / Shorter sentences / Stronger voice).
# Get a key at https://console.anthropic.com — without it the buttons do a quick rule-based tidy instead.
ANTHROPIC_API_KEY=
# Optional: override the model used for rewrites (default: claude-haiku-5-5)
ANTHROPIC_MODEL=
